# Copy this file to `server/.env` and fill in real values.
# Never commit the real .env file.

# --- Runtime -----------------------------------------------------------------
# "production" enables stricter checks (JWT secret length, CLIENT_URL required),
# hides internal error messages and switches to combined access logs.
NODE_ENV=development
PORT=5000

# --- Database (required) -----------------------------------------------------
# MongoDB connection string, including the database name.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/quick-chat?retryWrites=true&w=majority
# Set to "true" to let Mongoose build indexes on startup in production
# (always on in development). Needed once for the unique email index and the
# TTL indexes that expire OTP codes, unverified accounts and seen messages.
MONGO_AUTO_INDEX=false

# --- Auth (required) ---------------------------------------------------------
# Long random string, at least 32 characters in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# --- CORS --------------------------------------------------------------------
# Comma-separated list of origins allowed to call the API and open sockets.
# Required in production unless SERVE_CLIENT=true.
# A "*" may stand for one hostname label, for Vercel preview deploys:
#   CLIENT_URL=https://quick-chat.vercel.app,https://quick-chat-*-your-team.vercel.app
CLIENT_URL=http://localhost:3000

# Serve the React build (client/build) from this server on the same origin.
SERVE_CLIENT=false

# Number of reverse proxies in front of the app (Render/Heroku/Nginx = 1).
# Defaults to 1 in production, 0 otherwise. Needed for correct rate limiting.
# TRUST_PROXY=1

# --- Cloudinary (optional; image uploads are disabled without it) ------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=chat-app
# Maximum size of an uploaded image, in megabytes.
MAX_IMAGE_MB=5

# --- Email (required in production) ------------------------------------------
# Used to send sign-up verification and password-reset codes (OTP).
# Works with any SMTP provider: Gmail (app password), SendGrid, Mailgun, Resend, Amazon SES, Brevo...
# In development, if SMTP_HOST is empty the emails (and codes) are printed to the server console.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# "true" for port 465 (implicit TLS); "false" for 587 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Quick Chat <no-reply@example.com>"

# --- One-time passwords --------------------------------------------------------
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Unverified sign-ups are deleted after this many hours.
UNVERIFIED_ACCOUNT_TTL_HOURS=24
# Reject sign-ups whose email domain has no mail servers (DNS MX lookup).
EMAIL_MX_CHECK=true

# --- Disappearing messages ---------------------------------------------------
# Seen messages are permanently deleted this many seconds after being read
# (and immediately when either member closes the chat).
SEEN_MESSAGE_TTL_SECONDS=120
# How often the cleanup job runs. Deletion happens within TTL + this interval.
MESSAGE_SWEEP_INTERVAL_SECONDS=15

# --- AI models (users bring their own API keys) -------------------------------
# Encrypts users' provider API keys at rest (AES-256-GCM). Required in production
# for AI features; without it the AI endpoints return 503. At least 32 characters.
# Changing it makes existing stored keys unreadable (users must re-enter them).
AI_KEYS_SECRET=change-me-to-another-long-random-string
# Output limits that keep AI replies short.
AI_MAX_OUTPUT_TOKENS=800
AI_MAX_REPLY_CHARS=500
AI_REQUEST_TIMEOUT_SECONDS=90
# Generations per user per minute, and models per user.
AI_RATE_LIMIT_PER_MINUTE=20
AI_MAX_BOTS_PER_USER=10
# Previous messages sent as context in private AI chats.
AI_HISTORY_MESSAGES=10
# Allow custom endpoints on localhost/private networks (e.g. local Ollama).
# Defaults to true in development and false in production (prevents SSRF).
# ALLOW_PRIVATE_AI_ENDPOINTS=false

# --- Groups --------------------------------------------------------------------
GROUP_MAX_MEMBERS=50

# --- Rate limiting -----------------------------------------------------------
# Requests per minute per IP across the API.
RATE_LIMIT_PER_MINUTE=300
# Login/signup attempts per 15 minutes per IP.
AUTH_RATE_LIMIT=20
