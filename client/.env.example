# Copy to `client/.env.local` (development) or set in your hosting provider's
# build settings. CRA inlines REACT_APP_* values at BUILD time — they are public,
# so never put secrets here.

# URL of the API / Socket.IO server, without a trailing slash.
# - Development: defaults to http://localhost:5000 when unset.
# - Production: leave empty when the server serves the client (SERVE_CLIENT=true);
#   otherwise set it to the deployed API, e.g. https://api.example.com
# - Vercel: required. Set it in Project → Settings → Environment Variables; the build
#   fails with a clear message (client/scripts/check-env.js) if it's missing.
REACT_APP_API_URL=http://localhost:5000

# Must match MAX_IMAGE_MB on the server (client-side check only).
REACT_APP_MAX_IMAGE_MB=5

# Don't ship source maps to production (keeps bundle and source private).
GENERATE_SOURCEMAP=false
